                                    <StackPanel>
                                        <Grid><TextBlock Text="外观与活动" FontSize="{StaticResource TypeBody}" FontWeight="SemiBold" /><CheckBox x:Name="KeepOnTop" Content="总在最上层" HorizontalAlignment="Right" VerticalContentAlignment="Center" /></Grid>
                                        <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions><TextBlock Text="体型" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource TypeCaption}" VerticalAlignment="Center" /><Slider x:Name="SizeSlider" Grid.Column="1" Minimum="110" Maximum="240" Value="170" VerticalAlignment="Center" /><TextBlock x:Name="SizeValue" Grid.Column="2" Text="170 px" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{StaticResource TypeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" /></Grid>
                                        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions><TextBlock Text="步速" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource TypeCaption}" VerticalAlignment="Center" /><Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="25" Maximum="160" Value="72" VerticalAlignment="Center" /><TextBlock x:Name="SpeedValue" Grid.Column="2" Text="悠闲" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{StaticResource TypeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" /></Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PageCard}" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="精力与状态" FontSize="{StaticResource TypeBody}" FontWeight="SemiBold" />
                                        <Grid Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions><TextBlock Text="精力" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource TypeCaption}" VerticalAlignment="Center" /><ProgressBar x:Name="EnergyBar" Grid.Column="1" Minimum="0" Maximum="100" Height="7" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceAltBrush}" BorderThickness="0" /><TextBlock x:Name="EnergyValue" Grid.Column="2" Text="100%" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{StaticResource TypeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" /></Grid>
                                        <TextBlock x:Name="LifeStateValue" Text="状态 · 平静" FontSize="{StaticResource TypeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PageCard}" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><CheckBox x:Name="RandomSpeech" Content="随机聊聊天" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="{StaticResource TypeCaption}" /><Button x:Name="SpeakNow" Grid.Column="1" Content="说一句" Padding="10,6" /></Grid>
                                        <TextBlock x:Name="SpeechHint" Text="每隔一会儿送来一句小小的鼓励" FontSize="{StaticResource TypeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,9,0,0" />
                                    </StackPanel>
                                </Border>
                                <Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button x:Name="FindPet" Content="⌖  找回玉子" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Padding="12,11" /><Button x:Name="Quit" Grid.Column="2" Content="结束陪伴" Padding="12,11" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource DangerBrush}" /></Grid>
                                <TextBlock Text="学习计时仍可从桌宠右键菜单打开。" FontSize="{StaticResource TypeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,8" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
